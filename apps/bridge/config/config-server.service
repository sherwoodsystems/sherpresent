[Unit]
Description=RPi OSC Bridge - Configuration Web Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/rpi-osc-bridge
ExecStart=/opt/rpi-osc-bridge/venv/bin/python /opt/rpi-osc-bridge/config-server.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
