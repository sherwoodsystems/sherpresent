{
  "name": "sher-present-desktop",
  "version": "1.0.2",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "tauri": "tauri",
    "macos:sidecar": "bash ../../scripts/build-macos-sidecar.sh",
    "macos:test": "bash ../../scripts/swift-test.sh",
    "macos:format": "swift format -i -r sidecars/caption-output-macos/Sources/sherpresent-output sidecars/caption-output-macos/Sources/syphon-probe sidecars/caption-output-macos/Tests sidecars/speech-macos/Sources sidecars/speech-macos/Tests",
    "macos:dev": "bun run macos:sidecar && tauri dev",
    "macos:build": "bun run macos:sidecar && tauri build",
    "windows:start": "docker compose -f ../../docker-compose.windows.yml up -d",
    "windows:stop": "docker compose -f ../../docker-compose.windows.yml stop",
    "windows:build": "bash ../../scripts/build-windows.sh",
    "windows:build:keep": "bash ../../scripts/build-windows.sh --no-stop"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-dialog": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2.10.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.54.1",
    "svelte-check": "^4.4.5",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.3"
  }
}
