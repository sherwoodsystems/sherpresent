<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime blocks microphone access unless this is granted,
         even when Info.plist carries NSMicrophoneUsageDescription. Signed
         builds fail silently at capture start without it. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Likewise for Apple Events: without it the hardened runtime blocks
         every AppleScript the presentation adapters send, even with
         NSAppleEventsUsageDescription in Info.plist. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
