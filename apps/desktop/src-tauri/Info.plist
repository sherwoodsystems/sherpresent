<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for cpal to open an input device. Without this key macOS
         terminates the process the moment capture starts, rather than
         prompting. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>SherPresent listens to the selected audio input to generate live translated captions.</string>

    <!-- For the Apple on-device provider. SpeechAnalyzer with locally installed
         assets may not consult TCC at all, but if it does, a missing key kills
         the helper outright instead of prompting — which looks like an
         unexplained crash. One string is cheap insurance. -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>SherPresent transcribes the selected audio input on this Mac to generate live translated captions.</string>

    <!-- Every adapter on macOS is AppleScript: PowerPoint/Keynote for control,
         System Events for the "is it running" check. Once the app carries an
         Info.plist, a missing key makes macOS deny those Apple Events outright
         (-1743) without ever prompting, so the app reports PowerPoint as
         "not open" while it's sitting there. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>SherPresent controls PowerPoint and Keynote to advance your slides and read presenter notes.</string>
</dict>
</plist>
